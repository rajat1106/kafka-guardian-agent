# ─────────────────────────────────────────────────────────────
# Kafka Guardian Agent — configuration
# Copy to `.env` and edit. Everything has a working default for
# the local docker-compose stack; you only need to edit this file
# if you are pointing at Confluent Cloud or want the LLM planner.
# ─────────────────────────────────────────────────────────────

# ── Kafka target ─────────────────────────────────────────────
# provider: "local"     → self-hosted Kafka 4.x in KRaft mode (docker-compose)
#           "confluent" → Confluent Cloud
KAFKA_PROVIDER=local

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TOPIC_PREFIX=
KAFKA_REPLICATION_FACTOR=1

# ── Confluent Cloud example (uncomment and fill) ──────────────
# KAFKA_PROVIDER=confluent
# KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=<CLUSTER_API_KEY>
# KAFKA_SASL_PASSWORD=<CLUSTER_API_SECRET>
# Namespace for a SHARED cluster — do not repeat the topic family name here,
# or you get kga.guardian.anomalies-style doubling. Use a team/env token.
# KAFKA_TOPIC_PREFIX=kga-dev.
# KAFKA_REPLICATION_FACTOR=3
# Optional — only needed for the Confluent metrics/admin actuator:
# CONFLUENT_CLOUD_API_KEY=<CLOUD_API_KEY>
# CONFLUENT_CLOUD_API_SECRET=<CLOUD_API_SECRET>
# CONFLUENT_CLUSTER_ID=lkc-xxxxx
# CONFLUENT_ENVIRONMENT_ID=env-xxxxx

# ── Agent brain ──────────────────────────────────────────────
# With no API key the agent runs the deterministic offline planner.
# The whole demo works without a key; the LLM adds real diagnosis.
ANTHROPIC_API_KEY=

# Tiered model routing — cheap model triages, expensive model only
# handles incidents the triage step flags as non-obvious.
GUARDIAN_MODEL_TRIAGE=claude-haiku-4-5
GUARDIAN_MODEL_DIAGNOSE=claude-opus-5
GUARDIAN_EFFORT=low

# ── Token budget (hard caps — protects free-tier credits) ────
# Per-incident ceiling. Exceeding it aborts the LLM path and falls
# back to the offline planner rather than spending more.
GUARDIAN_TOKENS_PER_INCIDENT=12000
# Rolling hourly ceiling across all incidents.
GUARDIAN_TOKENS_PER_HOUR=120000
# Daily ceiling. Once hit, the agent runs offline-only until reset.
GUARDIAN_TOKENS_PER_DAY=400000
# Hard cap on agent tool-calling turns per incident.
GUARDIAN_MAX_TURNS=6
# Skip the LLM entirely for anomalies the detector scores below this.
GUARDIAN_LLM_MIN_SEVERITY=0.55

# ── Autonomy ─────────────────────────────────────────────────
# Blast-radius score at or below which actions auto-execute.
# Above it, the incident parks and waits for a human click.
GUARDIAN_AUTO_APPROVE_MAX_BLAST=2
ACTUATOR_MODE=sim
OPA_URL=http://opa:8181

# ── Storage ──────────────────────────────────────────────────
POSTGRES_DSN=postgresql://guardian:guardian@postgres:5432/guardian

# ── Demo pacing ──────────────────────────────────────────────
CHAOS_ENABLED=true
CHAOS_INTERVAL_SECONDS=90
